# Gmail IMAP credentials (dedicated job search inbox)
GMAIL_ADDRESS=your-job-alerts@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Track B fetch + archive behavior ────────────────────────────────────────
# Track B is an aggregator + archiver: only confirmed job alerts from the
# senders allowlisted in my_profile/email_config.yaml are ever marked read
# or moved; everything else stays untouched and unread. Behavior knobs
# (top_n, lookback_days, archive folder) live in email_config.yaml — these
# two env vars are kill-switches only.
#
# GMAIL_USE_X_GM_RAW — narrow the IMAP fetch to allowlisted senders using
# Gmail's X-GM-RAW search extension (same syntax as the Gmail search bar).
# Set to false to fall back to a plain UNSEEN search (e.g. non-Gmail IMAP);
# the classifier still protects downstream either way.
GMAIL_USE_X_GM_RAW=true
# EMAIL_ARCHIVE_ENABLED — after processing, mark alert emails read and move
# them to the archive folder (move-only; the pipeline never deletes mail).
# Set to false to leave the mailbox completely untouched.
EMAIL_ARCHIVE_ENABLED=true

# ─── OpenRouter ──────────────────────────────────────────────────────────────
# All LLM calls route through OpenRouter (https://openrouter.ai).
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# Track B — Stage 1: Structured extraction from raw email text.
# A fast, cheap model. This runs on every email.
OPENROUTER_STAGE1_MODEL=openai/gpt-5.4-nano

# Track A + B — Stage 5: Match scoring against your candidate profile.
# Used for all scoring calls and as the default fallback model.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Tailoring: resume edits, cover letters, interview prep. Also the autopilot
# re-score and the ranking fallback. Only used on the METERED route — the
# session route below bypasses it. See docs/MODELS.md before changing.
OPENROUTER_TAILOR_MODEL=anthropic/claude-sonnet-4.6

# ─── Session route (subscription-billed, not metered) ────────────────────────
# `claude -p` starts a headless Claude session billed to your subscription
# instead of OpenRouter credit. Used for the autopilot re-score — ~97% of
# per-listing enrichment cost, and few enough calls a day that the CLI's ~23k
# token startup overhead is irrelevant. NOT used for Stage 5, where 100+ small
# calls would make that overhead dominate.
#   session — use the Claude CLI, fall back to OpenRouter on any failure
#   api     — always use OpenRouter
AUTOPILOT_RESCORE_VIA=session
# Which model the session route asks for (sonnet / haiku / opus).
CLAUDE_CLI_MODEL=sonnet

# Trend analysis: skill canonicalization for the !trend ChatOps command.
# Uses a lightweight model — only runs on-demand when you post !trend in Slack.
OPENROUTER_TREND_MODEL=openai/gpt-4o-mini

# ─── Stage 5 confidence threshold ────────────────────────────────────────────
# A NO verdict is ALWAYS rejected — confidence is irrelevant. A YES or MAYBE
# verdict is kept only when its confidence (0.0–1.0) is at or above this
# threshold; otherwise it is dropped before reaching Slack.
#   0.0   — keep every YES/MAYBE; only NO is rejected
#   0.5   — default
#   0.75  — strict; only surface YES/MAYBE the model is highly confident about
# The same value also gates AUTO_MATCH: a YES verdict with confidence >=
# max(CONFIDENCE_THRESHOLD, 0.8) is marked AUTO_MATCH in the digest.
CONFIDENCE_THRESHOLD=0.75

# ─── Pipeline behavior ───────────────────────────────────────────────────────
# Assets generated per Tailor run (✏️ reaction or batch processor).
# Options: resume, cover_letter, interview_prep  (comma-separated)
# On-demand alternatives via ChatOps: !coverletter, !prep, !polish
#
# Two cover letter paths:
#   1. Bundled with tailor (`cover_letter` in GENERATE_ASSETS or via ✏️):
#      relies on a well-written `my_profile/cover_letter.{docx,md,pdf}` as a
#      style reference. The LLM mimics that tone/structure and also emits a
#      `cover_letter_diff_summary` describing what it changed. Skip this path
#      if you don't have a cover_letter template — without one, the model has
#      no voice to imitate and the output reads generic.
#   2. On-demand via Slack ChatOps `!coverletter`: writes a fresh cover letter
#      from the candidate profile + base resume + cached research, no diff
#      field, no template required. Use this if you don't maintain a cover
#      letter template, or for one-off cover letters per role.
GENERATE_ASSETS=resume
# ON_DEMAND=polished_resume,cover_letter,interview_prep

# Autopilot — speculative execution after Stage 5 scoring.
# When enabled, listings with a YES/MAYBE verdict at or above CONFIDENCE_THRESHOLD
# are queued for an asynchronous Speculative Agent that runs deep research and a
# Claude match-analysis pass up front (no expensive resume edits). Results are
# posted to Slack directly so the user can triage with full context. Any
# post-research NO verdict is auto-passed. Run after the pipeline with
# `python -m src.process_queue`, or use `./script.sh` to chain the full batch.
AUTOPILOT_ENABLED=true
# Max concurrent listings processed by the Speculative Agent.
AUTOPILOT_CONCURRENCY=3
# Max listings autopilot will finalize per UTC day. Only YES/MAYBE listings
# meeting CONFIDENCE_THRESHOLD are eligible; the highest-confidence rows go
# first. Set to 0 to disable autopilot for the day (same effect as
# AUTOPILOT_ENABLED=false). Set to a large value like 999 to process the
# entire queue per run.
AUTOPILOT_TOP_N=10

# Hide listings ingested more than N days ago from `src.cli next` (0
# disables; per-call override: --max-age). Age means FIRST-SEEN age — dedup
# skips re-seen listings without updating the row.
REVIEW_MAX_AGE_DAYS=30

# Stage 5 listwise batching (ranking_upgrade.md M-4). Listings scored per
# call: 0 or 1 keeps the per-listing (pointwise) path. Batching sends the
# candidate profile once instead of once per listing — measured at ~9x fewer
# input tokens with 98% verdict agreement against pointwise, on
# google/gemini-3.1-flash-lite. A batch that fails or returns partial JSON
# falls back to pointwise for the affected listings, so this is safe to raise.
# NOTE: validate before trusting a new model here — see
# `python -m eval.listwise_compare --gold --shuffle --model <slug>`.
STAGE5_LISTWISE_BATCH=0
# M-5 calibration anchor. Each batch carries one listing whose correct verdict
# is known from YOUR save/pass decisions (data/human_labels.jsonl) — the only
# verdict in the system not produced by a model. If a batch misjudges it, that
# batch's scores are discarded and its listings are scored individually.
# Measured motivation: with batching and no anchor, 6 of 24 listings crossed
# the CONFIDENCE_THRESHOLD gate purely because of which batch they landed in.
STAGE5_ANCHOR=true
# M-6: how autopilot picks its top-N. `listwise` ranks the surviving pool and
# takes the best by POSITION; `off` keeps the confidence-band heuristic.
# Position rather than score because confidence is only meaningful within one
# scoring batch — measured, batch composition alone moved 6 of 24 listings
# across an absolute threshold.
RANKING_MODE_STAGE5=off
# Confidence below which a Stage 5 survivor is discarded as noise. Defaults to
# CONFIDENCE_THRESHOLD. With RANKING_MODE_STAGE5=listwise, keep this LOW (~55):
# the ranking does the quality work, and a high floor starves its pool.
NOISE_FLOOR_PCT=

# --- Spend ceilings (cli_skill_interface.md C-3) -------------------------
# Guards against continuous or heavy spend, not against any single small
# decision: under the ceiling, an agent may fire runs freely. Checks refuse
# and report — they never truncate a batch half-way.
#
# Daily metered ceiling in USD. Compared against logs/model_usage.log priced
# via eval/model_pricing.py. 0 disables. In-session (subscription) work is
# not metered and never counts here.
DAILY_USD_BUDGET=3.00
# Minimum minutes between pipeline runs. This is the guard that catches a
# looping agent — no per-run ceiling can. 0 disables.
MIN_RUN_INTERVAL_MINUTES=60
# Optional expected USD cost of one run. When set, a run is refused if
# today's spend plus this estimate would breach DAILY_USD_BUDGET. Unset means
# "cannot project", which is reported rather than guessed around.
RUN_USD_ESTIMATE=
# Today's spend can only be priced for models present in model_pricing.py.
# By default an unpriced model BLOCKS the run, because a budget check must
# not pass on spend it cannot see. Set true to allow anyway.
BUDGET_ALLOW_UNPRICED=false
# Controls what reaches Slack from a Stage 5 batch.
#   false — High-signal mode (default, daily use). digest.py skips
#           auto_queued rows entirely; only the AUTOPILOT_TOP_N listings that
#           autopilot actually enriches get posted to Slack (by
#           process_queue, not digest). Sub-top-N rows remain in the DB with
#           full Stage 5 data — verdict, confidence, matching/missing skills,
#           model_scores — so nothing is recomputed if you later raise the
#           cap or run `python -m src.process_queue --backfill`. The digest.py
#           invocations in script.sh become near-no-ops (digest still posts
#           any stranded `triaged`/`saved` rows), and the CLI review queue
#           (`src.cli next`) likewise shows only autopilot-enriched rows —
#           `next --all-tiers` opts back into the raw Stage 5 view.
#   true  — Funnel-as-UI (debugging). digest.py posts EVERY YES/MAYBE listing
#           at or above CONFIDENCE_THRESHOLD as a card — a single run can put
#           dozens of un-researched MAYBEs in the channel; autopilot then
#           edits the top AUTOPILOT_TOP_N cards in place. Use when you need
#           full visibility into what Stage 5 is passing, not for daily runs.
AUTOPILOT_POST_STAGE_5=false

# ─── Autopilot quality gates (Fix 2a + Fix 4b) ───────────────────────────────
# Both gates run inside process_queue.py for the autopilot top-N path only —
# they never affect digest cards posted before autopilot enrichment. Drops
# from either gate emit an audit line to the `apply_daemon.audit.mismatch_drops`
# logger; see docs/AUDIT.md for the schema and grep recipes.
#
# MISMATCH_GATE_MODE — hybrid title↔body consistency check (Fix 2a).
#   hybrid          — Stage 1 substring check on the company-name tokens;
#                     fall back to an LLM check (cheap STAGE1 model) only on
#                     miss. Default. Recommended.
#   substring_only  — Skip the LLM fallback. Cheaper but loses synonym /
#                     stealth-mode handling. Use if LLM cost is a concern.
#   llm_only        — Always call the LLM. Maximum precision, more tokens.
#   off             — Disable the gate entirely.
MISMATCH_GATE_MODE=hybrid
# EXPIRED_PROBE_ENABLED — HTTP backstop for expired listings (Fix 4b).
# Stage 5 (Fix 4a) already catches expired language inside the description.
# This probe catches what Stage 5 can't see: 404s, LinkedIn auth-walls, and
# Track A rows whose stored description is from when the page was still live.
# Failure modes fail open (probe error → "unknown, proceed") so a flaky probe
# never silently drops a good listing. Set to false to disable.
EXPIRED_PROBE_ENABLED=true

# ─── Slack notifications ─────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789

# ─── Rotating residential proxy (optional, recommended for heavy scraping) ──
# Apply Daemon can route Track A (jobspy) and Track C (deep-research scrapes)
# through an IPRoyal sticky residential session. Without a proxy, aggressive
# polling of LinkedIn / Indeed will get your home IP rate-limited or banned.
# Leave these blank to scrape direct from your local IP (fine for ~10–20
# requests / day on DuckDuckGo + a friendly Indeed query).
#
# IPRoyal "magic-string" sticky session — see src/proxy_manager.py for details.
# IPROYAL_USERNAME=your-iproyal-user
# IPROYAL_PASSWORD=your-iproyal-pass
# IPROYAL_HOST=geo.iproyal.com
# IPROYAL_PORT=12321
# IPROYAL_SESSION_TTL_MINUTES=30
# IPROYAL_SCHEME=http   # one of: http, https, socks5, socks5h
